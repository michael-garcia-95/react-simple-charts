{
  "name": "@michael-garcia-95/react-simple-charts",
  "version": "0.0.0",
  "private": true,
  "description": "React and TypeScript SVG charts: Line, Area, Bar, Pie and Donut.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "npm run build && vite",
    "build": "tsdown",
    "build:playground": "npm run build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "test:types": "tsc --project tsconfig.types.json",
    "pretypecheck": "npm run build",
    "pretest": "npm run build",
    "dev:site": "npm run build && vite --config vite.site.config.ts",
    "build:site": "npm run build && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "test:site": "npm run build && vitest run tests/site.test.tsx tests/site-examples.test.tsx tests/site-paths.test.ts tests/site-documentation.test.tsx",
    "build:site:pages": "npm run build && vite build --config vite.site.config.ts --base=/react-simple-charts/",
    "verify:site:snippets": "npm run build && node scripts/verify-site-snippets.mjs",
    "verify:browsers": "node scripts/verify-browser-smoke.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-garcia-95/react-simple-charts.git"
  },
  "homepage": "https://michael-garcia-95.github.io/react-simple-charts/",
  "bugs": {
    "url": "https://github.com/michael-garcia-95/react-simple-charts/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "charts",
    "svg",
    "line-chart",
    "area-chart",
    "bar-chart",
    "pie-chart",
    "donut-chart"
  ],
  "publishConfig": {
    "access": "public"
  }
}
